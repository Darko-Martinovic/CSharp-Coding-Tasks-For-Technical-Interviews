<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Same strict settings as the task. The fixed code produces zero warnings. -->
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>

    <RootNamespace>NullableReferencesSolution</RootNamespace>
    <AssemblyName>NullableReferences-Solution</AssemblyName>
  </PropertyGroup>

</Project>
